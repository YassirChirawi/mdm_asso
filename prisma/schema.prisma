// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model DownloadStats {
  id        String   @id @default(cuid())
  fileName  String   @unique
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model ChapterStats {
  id        String   @id @default(cuid())
  chapterId String   @unique
  views     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model LegalDocument {
  id        String   @id @default(cuid())
  name      String
  url       String
  blobPath  String
  type      String?
  size      Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Donation {
  id        String   @id @default(cuid())
  stripeId  String   @unique
  amount    Int
  currency  String
  name      String
  firstName String?
  lastName  String?
  email     String
  createdAt DateTime @default(now())
}

model Benevole {
  id           String   @id @default(cuid())
  prenom       String
  nom          String
  email        String
  ville        String?
  disponibilite String?
  roles        String?
  motivation   String
  createdAt    DateTime @default(now())
}

model Adhesion {
  id        String   @id @default(cuid())
  prenom    String
  nom       String
  email     String
  ville     String?
  message   String?
  statut    String   @default("en_attente")
  createdAt DateTime @default(now())
}

